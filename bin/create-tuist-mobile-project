#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}"
)"
SCRIPT_DIR="$(
  cd "$(dirname "$SCRIPT_PATH")" && pwd
)"

ZACH_MOBILE_WIZARD_PROG="create-tuist-mobile-project" \
  exec -a create-tuist-mobile-project "$SCRIPT_DIR/zach-mobile-wizard" "$@"
